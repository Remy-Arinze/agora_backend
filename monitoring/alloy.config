logging {
  level  = "info"
  format = "logfmt"
}

// Scrape Agora backend metrics with the custom API key header
// The MetricsApiKeyGuard expects the key in the "x-metrics-api-key" header.
// Service name is "api", port is 4000 (internal Docker network).
prometheus.scrape "agora_backend" {
  targets = [{
    __address__ = "api:4000",
  }]
  forward_to   = [prometheus.remote_write.grafana_cloud.receiver]
  metrics_path = "/metrics"
  scrape_interval = "30s"

  http_client_config {
    header = {
      "x-metrics-api-key" = [env("METRICS_API_KEY")],
    }
  }
}

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_PROMETHEUS_URL")
    basic_auth {
      username = env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = env("GRAFANA_CLOUD_PROMETHEUS_TOKEN")
    }
  }
}
