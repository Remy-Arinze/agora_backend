logging {
  level  = "info"
  format = "logfmt"
}

// ─── Redis exporter ──────────────────────────────────────────────────────────
// Scrapes Redis metrics from the internal redis service.

prometheus.exporter.redis "agora_redis" {
  redis_addr     = join(["redis:", env("REDIS_PORT")], "")
  redis_password = env("REDIS_PASSWORD")
}

// ─── PostgreSQL exporter ─────────────────────────────────────────────────────
// Scrapes DB metrics from the internal postgres service.
// Requires a read-only monitoring user (see scripts/create-monitoring-user.sql).

prometheus.exporter.postgres "agora_db" {
  data_source_names = [env("POSTGRES_MONITOR_URL")]

  autodiscover_databases = true

  enabled_collectors = [
    "bgwriter",
    "database",
    "locks",
    "replication",
    "replication_slot",
    "stat_bgwriter",
    "stat_database",
    "stat_statements",
    "stat_user_tables",
    "statio_user_tables",
    "wal",
  ]
}

// ─── Prometheus scrape: backend API ─────────────────────────────────────────

prometheus.scrape "agora_backend" {
  targets         = [{ __address__ = "api:4000" }]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  metrics_path    = "/metrics"
  scrape_interval = "30s"

  http_client_config {
    header = {
      "x-metrics-api-key" = [env("METRICS_API_KEY")],
    }
  }
}

// ─── Prometheus scrape: PostgreSQL ──────────────────────────────────────────

prometheus.scrape "agora_postgres" {
  targets         = prometheus.exporter.postgres.agora_db.targets
  forward_to      = [
    prometheus.remote_write.grafana_cloud.receiver,
    prometheus.remote_write.openobserve.receiver,
  ]
  scrape_interval = "30s"
}

// ─── Prometheus scrape: Redis ────────────────────────────────────────────────

prometheus.scrape "agora_redis" {
  targets         = prometheus.exporter.redis.agora_redis.targets
  forward_to      = [
    prometheus.remote_write.grafana_cloud.receiver,
    prometheus.remote_write.openobserve.receiver,
  ]
  scrape_interval = "30s"
}

// ─── Remote write: Grafana Cloud (existing) ──────────────────────────────────

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_PROMETHEUS_URL")
    basic_auth {
      username = env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = env("GRAFANA_CLOUD_PROMETHEUS_TOKEN")
    }
  }
}

// ─── Remote write: OpenObserve ───────────────────────────────────────────────
// OpenObserve exposes a Prometheus-compatible remote_write endpoint at
// /api/<org>/prometheus/api/v1/write — we push DB metrics there so they
// appear alongside the application logs and queue events already shipping
// from the NestJS logger.

prometheus.remote_write "openobserve" {
  endpoint {
    url = join([env("OPENOBSERVE_ENDPOINT_BASE"), "/prometheus/api/v1/write"], "")

    headers = {
      "Authorization" = join(["Basic ", env("OPENOBSERVE_ACCESS_KEY")], ""),
    }
  }
}
