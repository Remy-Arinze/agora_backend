# ============================================================
# Agora Backend — Production Environment Variables
# ============================================================
# Copy this file to .env.prod and fill in every value.
# NEVER commit .env.prod to version control.
# Generate secrets with: openssl rand -hex 32
# ============================================================

# ─── Server ─────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
FRONTEND_URL=https://yourdomain.com

# ─── Database (PostgreSQL — internal Docker service) ────────
# These credentials are used by both the `db` service and the
# DB_URL connection string. Use strong random values.
POSTGRES_USER=agora
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=agora

# DB_URL is built from the above — db hostname is "db" (Docker service name)
DB_URL=postgresql://agora:CHANGE_ME_strong_random_password@db:5432/agora?schema=public

STUDENT_UID_SUFFIX_LENGTH=6

# ─── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_char_hex_string
JWT_EXPIRES_IN=1d

# Internal server-to-server bearer token
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME_internal_api_key

# ─── Redis (internal Docker service) ────────────────────────
# Password is passed to both the redis container and the API.
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_redis_password

# ─── Email (SMTP) ────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_SECURE=false
MAIL_FROM=your_email@gmail.com

# ─── Storage driver ──────────────────────────────────────────
# Options: cloudinary (default) | s3
STORAGE_DRIVER=cloudinary

# ─── Cloudinary (active when STORAGE_DRIVER=cloudinary) ──────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── S3 / Garage (active when STORAGE_DRIVER=s3) ─────────────
# S3_ENDPOINT=https://garage.yourdomain.com
# S3_REGION=garage                           # Garage ignores this; SDK needs a value
# S3_ACCESS_KEY_ID=your_garage_access_key_id
# S3_SECRET_ACCESS_KEY=your_garage_secret_access_key
# S3_BUCKET=agora
# S3_PUBLIC_BASE_URL=https://garage.yourdomain.com

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Priority: OpenAI (primary) → OpenRouter (fallback) → Azure (final fallback)

# 1. Standard OpenAI — primary provider for both chat and embeddings
OPENAI_API_KEY=your_openai_api_key
# Optional: override the default model (gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# 2. OpenRouter — fallback when OPENAI_API_KEY is not set
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# When using OpenRouter, set OPENAI_MODEL to an OpenRouter model slug:
# OPENAI_MODEL=openai/gpt-4o-mini

# 3. Azure OpenAI — final fallback when neither above is set
# AZURE_OPENAI_API_KEY=your_azure_openai_key
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Azure embeddings — fallback when OPENAI_API_KEY is not set
# Azure_OPENAI_EMBEDDING_ENDPOINT=https://your-embedding-resource.cognitiveservices.azure.com
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# AZURE_OPENAI_EMBEDDING_API_VERSION=2023-05-15
# AZURE_OPENAI_EMBEDDING_API_KEY=your_embedding_key

AGORA_CREDITS_PER_1M_TOKENS=1000

# ─── Payments (Paystack) ─────────────────────────────────────
# Use LIVE keys in production
PAYSTACK_SECRET_KEY=sk_live_your_live_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_live_public_key
# Generate with: openssl rand -hex 32
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
PAYMENT_WEBHOOK_ALLOWED_IPS=52.31.139.75,52.49.173.169,52.214.14.220

# ─── Google Calendar (optional) ──────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/dashboard

# ─── Monitoring ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
METRICS_API_KEY=CHANGE_ME_metrics_key

# Bugsink Error Tracking (self-hosted)
BUGSINK_DSN=http://your_project_key@bugsink.yourdomain.com:8000/your_project_id
# Generate with: openssl rand -hex 32
BUGSINK_SECRET_KEY=CHANGE_ME_bugsink_secret_key
BUGSINK_ALLOWED_HOSTS=bugsink.yourdomain.com,localhost

# OpenObserve (Logs, Metrics, Traces)
# OPENOBSERVE_ENDPOINT is used by the NestJS logger (JSON log stream)
OPENOBSERVE_ENDPOINT=https://console-observe.agora-schools.com/api/default/nodejs/_json
# OPENOBSERVE_ENDPOINT_BASE is used by Grafana Alloy (Prometheus remote_write)
OPENOBSERVE_ENDPOINT_BASE=https://console-observe.agora-schools.com/api/default
OPENOBSERVE_ACCESS_KEY=YWRtaW5AYWdvcmEuY29tOnhwa1Q3dUhSVm54ZVo3bk0=

# PostgreSQL monitoring user (read-only, for Grafana Alloy postgres exporter)
# Run scripts/create-monitoring-user.sql first to create this user
POSTGRES_MONITOR_URL=postgresql://agora_monitor:CHANGE_ME_monitor_password@db:5432/agora?sslmode=disable

GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USER=your_grafana_user_id
GRAFANA_CLOUD_PROMETHEUS_TOKEN=your_grafana_cloud_token
